@model EmployeeCreateViewModel
@* @inject IEmployeeRepository _empRepository *@
@{
    ViewData["Title"] = "Create Employee";
}
<form enctype="multipart/form-data" asp-controller="Home" asp-action="Create" method="post">
    <div class="mb-3 row">
        <label asp-for="Name" class="col-sm-2 col-form-label">Name</label>
        <div class="col-sm-10">
            <input asp-for="Name" class="form-control" placeholder="Name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>
    <div class="mb-3 row">
        <label asp-for="Email" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Email" class="form-control" placeholder="Email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
    </div>
    <div class="mb-3 row">
        <label asp-for="Department" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <select asp-for="Department" class="form-select" asp-items="Html.GetEnumSelectList<Dept>()">
                <option value="">Please Select</option>v
            </select>
            <span asp-validation-for="Department" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3 row">
        <label asp-for="Photo" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <div class="input-group mb-3">
                <input multiple type="file" class="form-control" id="Photo" name="Photo" />
                <label class="input-group-text ml-auto" for="Photo">Browse</label>
            </div>
        </div>
    </div>

    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3 row">
        <div class="col-sm-10">
            <button type="submit" class="btn btn-primary">Create</button>
        </div>
    </div>
    @* <div class="mb-3 row">
    <div class="col-sm-10">
    Totals Employee Count = @_empRepository.GetAllEmployee().Count()
    </div>
    </div> *@
</form>

