@model EmployeeEditViewModel
@{
    ViewData["Title"] = "Edit Employee";
    var photoPath = Url.Content("~/Images/" + (Model.ExistingPhotopath ?? "noimage.jpg"));
}


<h1>Edit</h1>

<form enctype="multipart/form-data" asp-controller="Home" asp-action="Edit" method="post">
    <input hidden asp-for="Id" />
    <input hidden asp-for="ExistingPhotopath" />
    <div class="mb-3 row">
        <label asp-for="Name" class="col-sm-2 col-form-label">Name</label>
        <div class="col-sm-10">
            <input asp-for="Name" class="form-control" placeholder="Name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>
    <div class="mb-3 row">
        <label asp-for="Email" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Email" class="form-control" placeholder="Email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
    </div>
    <div class="mb-3 row">
        <label asp-for="Department" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <select asp-for="Department" class="form-select" asp-items="Html.GetEnumSelectList<Dept>()">
                <option value="">Please Select</option>v
            </select>
            <span asp-validation-for="Department" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3 row">
        <label asp-for="Photo" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <div class="input-group mb-3">
                <input multiple asp-for="Photo" type="file" class="form-control" id="Photo" name="Photo" />
                <label class="input-group-text ml-auto" for="Photo">Click here to change photo</label>
            </div>
        </div>
    </div>

    @* <div class="form-group row col-sm-4 offset-4">
        <img src="@photoPath" class="imageThumbnail" asp-append-version="true" />
    </div> *@
    <div class="form-group row justify-content-md-center">
        <div class="col-md-4">
            <img src="@photoPath" class="imageThumbnail" asp-append-version="true" />
        </div>
    </div>


    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3 row">
        <div class="col-sm-10">
            <button type="submit" class="btn btn-primary">Update</button>
            <a asp-controller="home" asp-action="index" class="btn btn-primary">Cancel</a>
        </div>
    </div>
    @* <div class="mb-3 row">
    <div class="col-sm-10">
    Totals Employee Count = @_empRepository.GetAllEmployee().Count()
    </div>
    </div> *@
</form>