@model IEnumerable<Employee>
@{
    ViewData["Title"] = "Employee List";
}

<div class="row row-cols-1 row-cols-md-3">
    @foreach (var employee in Model)
    {
        var photoPath = $"~/Images/{employee.Photopath ?? "noimage.jpg"}";

        <div class="col mb-4">
            <div class="card">
                <div class="card-header">
                    <h3>@employee.Name</h3>
                </div>
                <img class="card-img-top imageThumbnail" src="@Url.Content(photoPath)" asp-append-version="true" />
                <div class="card-footer text-center">
                    <a asp-controller="home" asp-action="details" asp-route-id="@employee.Id" class="btn btn-primary m-1">View</a>
                    <a asp-controller="home" asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-primary m-1">Edit</a>
                    <form asp-controller="home" asp-action="DeleteConfirmed" class="d-inline" method="post">
                        <input type="hidden" name="id" value="@employee.Id" />
                        <button type="submit" class="btn btn-danger m-1" onclick="return confirm('Are you sure you want to delete this employee?')">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>


